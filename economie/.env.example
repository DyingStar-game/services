PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (docker/docker-compose.yml builds DATABASE_URL from the POSTGRES_* values)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=economie
POSTGRES_PORT=5432
DATABASE_URL=postgresql://user:password@localhost:5432/economie

# Keycloak — player JWTs are validated against the realm JWKS (RS256); the `sub` claim is the player id
OIDC_ISSUER=http://keycloak:8080/realms/dyingstar
# Defaults to ${OIDC_ISSUER}/protocol/openid-connect/certs
OIDC_JWKS_URL=
# Optional: expected `aud` claim; leave empty to skip the audience check
OIDC_AUDIENCE=

# Shared secret for the game server / other services (header X-Internal-Key)
INTERNAL_API_KEY=change-me

# Local dev without Keycloak: accept X-Player-Id / X-Player-Name headers instead of a JWT.
# Ignored when NODE_ENV=production.
AUTH_DEV_BYPASS=false

# Economy: automatic tax applied to player-to-player transfers (basis points, 500 = 5%).
# Amounts are integer minor units (crédits).
ECONOMY_TRANSFER_TAX_BPS=500
# Ceiling of the absolute tax amount per transfer (0 = no ceiling)
ECONOMY_TRANSFER_TAX_CEILING=0
# Smallest allowed transfer (in minor units)
ECONOMY_MIN_TRANSFER=1
# Largest allowed transfer (0 = no cap)
ECONOMY_MAX_TRANSFER=0
# Reserved account collecting automatic taxes (system holder)
ECONOMY_TAX_VAULT_UUID=00000000-0000-0000-0000-000000000001