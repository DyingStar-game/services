# Horizon WebSocket URL the NPCs connect to.
HORIZON_URL=ws://server.dyingstar-game.space:7040

# Bind address for the admin REST API.
ADMIN_BIND=0.0.0.0:9400

# Paths (relative to working directory) to NPC config files.
ROSTER_PATH=config/npcs.yaml
NAMES_PATH=config/names.txt

# HMAC-SHA256 secret used to sign NPC JWTs.
# Must match the secret Horizon uses to verify player tokens.
JWT_SECRET=changeme

# Action scheduler tick interval (ms).
TICK_INTERVAL_MS=200

# Settling delay (ms) after a session is established before actions start.
# Inbound frames still populate the world view during this window.
ACTION_STARTUP_DELAY_MS=10000

# WS reconnect backoff bounds (ms).
RECONNECT_BACKOFF_INITIAL_MS=1000
RECONNECT_BACKOFF_MAX_MS=30000

# --- Planetary clock & shift schedule ---

# resourcesDynamic REST API — source of each planet's rotation period.
RESOURCES_DYNAMIC_HTTP=http://localhost:3001

# Default planet (internal_name or name) for NPCs whose place_where_work.planet
# is unset. Resolves the rotation period from resourcesDynamic.
PLANET_INTERNAL_NAME=tarsis_4

# Rotation period (hours) used if resourcesDynamic is unreachable / planet unknown.
ROTATION_H_FALLBACK=25.0

# How often (seconds) to refresh the planet catalogue.
CLOCK_REFRESH_SECS=3600

# Rota length (planetary days) and which day "day 0" aligns to.
ROTA_DAYS=5
ROTA_EPOCH_OFFSET_DAYS=0

# Shift-schedules file.
SCHEDULES_PATH=config/schedules.yaml

# Test hooks (leave unset in production):
#   CLOCK_OVERRIDE_UNIX  pin planetary time to an exact Unix second
#   CLOCK_TIME_SCALE     speed up planetary time (1.0 = real; 3600 = 1 h/s)
# CLOCK_OVERRIDE_UNIX=0
# CLOCK_TIME_SCALE=1.0

# Logging
RUST_LOG=npc=info,tower_http=info
