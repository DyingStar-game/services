# Horizon WebSocket URL the NPCs connect to.
HORIZON_URL=ws://server.dyingstar-game.space:7040

# Bind address for the admin REST API.
ADMIN_BIND=0.0.0.0:9400

# PostgreSQL: the roster (one row per NPC), shift schedules, manual tasks, events.
# docker/docker-compose.yml starts one (user/password/db `npc`).
DATABASE_URL=postgres://npc:npc@localhost:5432/npc

# Delay (ms) between two spawns, to spread Horizon connections.
SPAWN_STAGGER_MS=200

# --- Keycloak ---
# Every NPC is a Keycloak user (group `npcs`, realm role `npc`) logging in with
# its own login + password (password grant on NPC_LOGIN_CLIENT_ID). The service
# account SERVICE_CLIENT_ID creates and repairs those users (fine-grained
# permissions on group `npcs`) and reads universesimulator.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=dyingstar
NPC_LOGIN_CLIENT_ID=npc-login
NPC_LOGIN_CLIENT_SECRET=
SERVICE_CLIENT_ID=svc-npc
SERVICE_CLIENT_SECRET=

# AES-256 key sealing the NPC passwords in the database: base64 of 32 bytes,
# `openssl rand -base64 32`. Losing it means resetting every password (the
# service does it by itself at the next login of each NPC).
NPC_PASSWORD_KEY=

# Tokens accepted on the admin API (staff, forwarded by the adminpanel BFF).
# Defaults derive from KEYCLOAK_URL/KEYCLOAK_REALM; OIDC_ISSUER must be the
# public issuer the tokens carry.
# OIDC_ISSUER=http://localhost:8080/realms/dyingstar
# OIDC_JWKS_URL=http://localhost:8080/realms/dyingstar/protocol/openid-connect/certs
# OIDC_AUDIENCE=
# Dev only (refused when APP_ENV=production): X-Player-Id / X-Player-Roles headers.
AUTH_DEV_BYPASS=false
APP_ENV=development

# universesimulator (without /api): main warehouse of a village, where its five
# storekeepers work. Unset = the nearest cargo_depot the NPC sees.
UNIVERSESIMULATOR_URL=

# Admin panel: days of NPC events kept, log lines kept in memory per NPC.
NPC_EVENTS_RETENTION_DAYS=7
NPC_LOG_BUFFER_LINES=500

# Role templates and generated-name lists.
ROLES_PATH=config/roles.yaml
FIRST_NAMES_PATH=config/names/first.txt
LAST_NAMES_PATH=config/names/last.txt

# Action scheduler tick interval (ms).
TICK_INTERVAL_MS=200

# Settling delay (ms) after a session is established before actions start.
# Inbound frames still populate the world view during this window.
ACTION_STARTUP_DELAY_MS=10000

# WS reconnect backoff bounds (ms).
RECONNECT_BACKOFF_INITIAL_MS=1000
RECONNECT_BACKOFF_MAX_MS=30000

# --- Planetary clock & shift schedule ---

# resourcesDynamic REST API — source of each planet's rotation period.
RESOURCES_DYNAMIC_HTTP=http://localhost:3001

# Default planet (internal_name or name) for NPCs whose place_where_work.planet
# is unset. Resolves the rotation period from resourcesDynamic.
PLANET_INTERNAL_NAME=tarsis_4

# Rotation period (hours) used if resourcesDynamic is unreachable / planet unknown.
ROTATION_H_FALLBACK=25.0

# How often (seconds) to refresh the planet catalogue.
CLOCK_REFRESH_SECS=3600

# Rota length (planetary days) and which day "day 0" aligns to.
ROTA_DAYS=5
ROTA_EPOCH_OFFSET_DAYS=0

# Shift-schedules file, imported into the database on first boot and on demand
# (admin panel, or `npc import-schedules [--overwrite] [file]`).
SCHEDULES_PATH=config/schedules.yaml

# Test hooks (leave unset in production):
#   CLOCK_OVERRIDE_UNIX  pin planetary time to an exact Unix second
#   CLOCK_TIME_SCALE     speed up planetary time (1.0 = real; 3600 = 1 h/s)
# CLOCK_OVERRIDE_UNIX=0
# CLOCK_TIME_SCALE=1.0

# --- Driving (drive_to_factory) ---

# Villages + roads per planet (copies of the QGIS exports), routing choices,
# and the scene layouts exported from Godot (tools/npc/npc_layout_export.gd).
WORLD_DATA_DIR=config/world
ROUTING_CONFIG=config/routing.yaml
SCENE_LAYOUTS_DIR=config/scene_layouts

# Control period (ms) of the driving loop.
DRIVE_TICK_MS=100

# Logging
RUST_LOG=npc=info,tower_http=info
