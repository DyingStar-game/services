PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (docker/docker-compose.yml builds DATABASE_URL from the POSTGRES_* values)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=mission
POSTGRES_PORT=5432
DATABASE_URL=postgresql://user:password@localhost:5432/mission

# Keycloak — player JWTs are validated against the realm JWKS (RS256); the `sub` claim is the player id
OIDC_ISSUER=http://keycloak:8080/realms/dyingstar
# Defaults to ${OIDC_ISSUER}/protocol/openid-connect/certs
OIDC_JWKS_URL=
# Optional: expected `aud` claim for player tokens; leave empty to skip the audience check
OIDC_AUDIENCE=
# Expected `aud` of service-account tokens (client_credentials) on /api/internal/*
OIDC_SERVICE_AUDIENCE=mission-api

# Trusted Keycloak service clients (`azp`) allowed on /api/internal/*
INTERNAL_SERVICE_CLIENTS=svc-game

# Legacy shared secret. Only honoured in dev when INTERNAL_DEV_BYPASS=true.
INTERNAL_API_KEY=change-me

# Local dev without Keycloak: accept X-Internal-Key on /api/internal/* instead of a
# service-account JWT. Ignored when NODE_ENV=production (which refuses to start if true).
INTERNAL_DEV_BYPASS=false

# Local dev without Keycloak: accept X-Player-Id / X-Player-Name headers instead of a JWT.
# Ignored when NODE_ENV=production.
AUTH_DEV_BYPASS=false

# Economy service used to pay economic rewards on mission completion.
ECONOMY_API_URL=http://localhost:3000
# Mission's own Keycloak service account (client_credentials) used to call the Economy
# internal API. Economy must trust `svc-mission` and grant it `economie:wallet:credit`.
ECONOMY_SERVICE_CLIENT_ID=svc-mission
ECONOMY_SERVICE_CLIENT_SECRET=
# Dev-only fallback: when no service client secret is set, send this X-Internal-Key
# to Economy (requires ECONOMY's INTERNAL_DEV_BYPASS=true).
ECONOMY_INTERNAL_API_KEY=

# Social service used to verify corporation membership (corporation-scoped missions).
# Leave empty to disable corporation missions. Social must trust `svc-mission` and grant
# it `social:corporation:read`.
SOCIAL_API_URL=
SOCIAL_SERVICE_CLIENT_ID=svc-mission
SOCIAL_SERVICE_CLIENT_SECRET=
SOCIAL_INTERNAL_API_KEY=

# Inventory service used to escrow and grant item rewards. Leave empty to disable item
# rewards. Inventory must trust `svc-mission` and grant it `inventory:hold` and
# `inventory:transfer`.
INVENTORY_API_URL=
INVENTORY_SERVICE_CLIENT_ID=svc-mission
INVENTORY_SERVICE_CLIENT_SECRET=
INVENTORY_INTERNAL_API_KEY=
# System holder used as the item faucet for non-escrowed (system/scenario) item rewards.
INVENTORY_SYSTEM_HOLDER_ID=00000000-0000-0000-0000-000000000001

# Pay economic rewards automatically when a mission is completed (true) or only via
# the internal settle endpoint (false).
MISSION_REWARD_AUTO_SETTLE=true
# Default lifetime of a mission in hours (0 = never expires).
MISSION_DEFAULT_TTL_HOURS=0
