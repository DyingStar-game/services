# ==== Champs communs ====
uuid: string @index(hash) .    # Identifiant unique
type_obj: string .
type_go: string .  
parent: uid @reverse . # Relation hiérarchique enfant -> parent
#=== Champs Domain ====
name: string @index(exact, term) .      # Nom de l'entité
username: string @index(exact, term) .
system: uid @reverse .
planet: uid @reverse .
# ==== Champs Position ====
x: float .                               
y: float .                                
z: float .                             
rx: float .
ry: float .
rz: float .
# ==== Types ====
type Position {
  x
  y
  z
  rx
  ry
  rz
}

type Entity {                             # Type générique
  uuid
  parent
  type_obj
}

type System {
  name
  <~system> 
}

type Planet {
  name
  system
  <~planet> 
  <~parent>                           
}

type Moon {
  name
  planet
  <~parent>                           
}

type Player {
  username
}

type Box {}
type MiningRock {}