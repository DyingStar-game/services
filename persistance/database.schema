# ==== Champs communs ====
uuid: string @index(hash) .    # Identifiant unique
name: string @index(exact, term) .      # Nom de l'entité
username: string @index(exact, term) .
parent: uid @reverse .                  # Relation hiérarchique enfant -> parent
position: uid .                         # Lien vers un nœud Position
type_obj: string .
type_go: string .
# ==== Champs Position ====
x: float .                               
y: float .                                
z: float .                             
rx: float .
ry: float .
rz: float .
# ==== Types ====
type Position {
  x
  y
  z
  rx
  ry
  rz
}

type Entity {                             # Type générique
  uuid
  parent
  type_obj
}

type Planet {
  name
  <~parent>                           
}

type Player {
  username
}