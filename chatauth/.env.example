PORT=3000

# Keycloak — player JWTs are validated against the realm JWKS (RS256)
OIDC_ISSUER=http://keycloak:8080/realms/dyingstar
# Defaults to ${OIDC_ISSUER}/protocol/openid-connect/certs
OIDC_JWKS_URL=
# Defaults to ${OIDC_ISSUER}/protocol/openid-connect/token (client_credentials to Social)
OIDC_TOKEN_URL=

# First topic segment (topics: {root}/global, {root}/dm/{from}/{to}, {root}/group/{id},
# {root}/corporation/{id})
CHAT_TOPIC_ROOT=chat
# Legacy allowlist for non-scoped topics (scoped channels ignore this list)
CHAT_ALLOWED_TOPICS=chat/global,chat/general

# Social service internal API (membership + mute/ban probes). Leave CHAT_SOCIAL_API_URL
# empty to disable: DM/group/corporation channels are then refused.
CHAT_SOCIAL_API_URL=http://social:3000
CHAT_SOCIAL_SERVICE_CLIENT_ID=svc-chat
CHAT_SOCIAL_SERVICE_CLIENT_SECRET=change-me

# In-memory cache of membership/mute probes
CHAT_ACL_CACHE_TTL_SECONDS=30
CHAT_ACL_CACHE_MAX=10000
