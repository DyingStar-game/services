PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (docker/docker-compose.yml builds DATABASE_URL from the POSTGRES_* values)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=social
POSTGRES_PORT=5432
DATABASE_URL=postgresql://user:password@localhost:5432/social

# Valkey cache (live presence with TTL + playtime accumulator). Empty VALKEY_URL disables
# the cache: the API falls back to the database only (legacy behaviour).
VALKEY_URL=redis://localhost:6379
# A player without a heartbeat for this long reads back as offline (the game server
# should refresh the presence batch every ~60s)
PRESENCE_TTL_SECONDS=90
# How often cached playtime deltas are flushed to PostgreSQL
PLAYTIME_FLUSH_INTERVAL_MINUTES=5
# Maximum players accepted by one PUT /api/internal/players/presence/batch call
PRESENCE_BATCH_MAX=5000

# MQTT broker for ephemeral player notifications (POST /api/internal/players/:id/notifications).
# Empty MOSQUITTO_URL disables the publisher: calls return {delivered:false, reason:"unreachable"}.
MOSQUITTO_URL=mqtt://localhost:1883
# Service client authenticating on the broker: its Keycloak token is sent as the MQTT
# password and its `azp` must be listed in chatauth's CHAT_SERVICE_CLIENTS.
# Empty secret connects anonymously — dev broker only (docker/docker-compose.yml).
MQTT_CLIENT_ID=svc-social
MQTT_CLIENT_SECRET=
# Defaults to ${OIDC_ISSUER}/protocol/openid-connect/token (client_credentials)
MQTT_TOKEN_URL=
# Notifications are published to {MQTT_TOPIC_ROOT}/{playerId}
MQTT_TOPIC_ROOT=notify

# Keycloak — player JWTs are validated against the realm JWKS (RS256)
OIDC_ISSUER=http://keycloak:8080/realms/dyingstar
# Defaults to ${OIDC_ISSUER}/protocol/openid-connect/certs
OIDC_JWKS_URL=
# Optional: expected `aud` claim for player tokens; leave empty to skip the audience check
OIDC_AUDIENCE=
# Expected `aud` of service-account tokens (client_credentials) on /api/internal/*
OIDC_SERVICE_AUDIENCE=social-api

# Trusted Keycloak service clients (`azp`) allowed on /api/internal/*
# (svc-game, svc-market, svc-chat = MQTT broker ACL checks for DM/group/corp chats)
INTERNAL_SERVICE_CLIENTS=svc-game,svc-market,svc-chat

# Legacy shared secret. Only honoured in dev when INTERNAL_DEV_BYPASS=true.
INTERNAL_API_KEY=change-me

# Local dev without Keycloak: accept X-Internal-Key on /api/internal/* instead of a
# service-account JWT. Ignored when NODE_ENV=production (which refuses to start if true).
INTERNAL_DEV_BYPASS=false

# Local dev without Keycloak: accept X-Player-Id / X-Player-Name headers instead of a JWT.
# Ignored when NODE_ENV=production.
AUTH_DEV_BYPASS=false

# Reputation: penalties (positive numbers, subtracted), thresholds (negative scores) and rehabilitation
REPUTATION_BLOCK_PENALTY=1
REPUTATION_REPORT_PENALTY=2
REPUTATION_UPHELD_REPORT_PENALTY=10
REPUTATION_WARN_AT=-10
REPUTATION_MUTE_AT=-25
REPUTATION_MUTE_HOURS=24
REPUTATION_SUSPEND_AT=-50
REPUTATION_SUSPEND_HOURS=168
REPUTATION_ESCALATE_AT=-75
REPUTATION_REHAB_AFTER_DAYS=7
REPUTATION_REHAB_STEP=1
REPUTATION_REHAB_INTERVAL_MINUTES=60
