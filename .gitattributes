# Shell scripts MUST use LF line endings. A CRLF shebang (`#!/bin/sh\r`) makes the
# kernel look for `/bin/sh\r`, so the container fails to start with
# `exec ./entrypoint.sh: no such file or directory` — which bites Windows
# contributors building the images locally (Git checks out CRLF by default).
*.sh text eol=lf

# SQL migrations MUST use LF too: sqlx stores a checksum of each applied migration and refuses to start
# ("migration 1 was previously applied but has been modified") when an image built from a CRLF checkout
# meets a database migrated by an LF one.
*.sql text eol=lf
