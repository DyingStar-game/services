# ── Service ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://universesimulator:universesimulator@localhost:5434/universesimulator
BIND=0.0.0.0:9600
APP_ENV=development
RUST_LOG=universesimulator=info,tower_http=info

# ── Simulation (ADR 0010) ────────────────────────────────────────────────────
SIM_ENABLED=true
SIM_TICK_SECONDS=300
# Game hours per real hour.
SIM_TIME_SCALE=1.0
SIM_LEG_MAX_ATTEMPTS=3
SIM_POLITICAL_REFRESH_MINUTES=15
SIM_HISTORY_DAYS=14

# ── Inbound auth (ADR 0011) ──────────────────────────────────────────────────
OIDC_ISSUER=http://keycloak:8080/realms/dyingstar
# OIDC_JWKS_URL=${OIDC_ISSUER}/protocol/openid-connect/certs
# OIDC_AUDIENCE=
OIDC_SERVICE_AUDIENCE=universesimulator-api
INTERNAL_SERVICE_CLIENTS=svc-game,svc-admin
INTERNAL_API_KEY=change-me
# Dev only (refused when APP_ENV=production): X-Player-Id / X-Player-Roles and X-Internal-Key.
AUTH_DEV_BYPASS=true
INTERNAL_DEV_BYPASS=true

# ── Outbound ─────────────────────────────────────────────────────────────────
# live: real calls; dry_run: in-memory stand-in for every service (no other service needed).
EXTERNAL_MODE=dry_run
# OIDC_TOKEN_URL=${OIDC_ISSUER}/protocol/openid-connect/token
SERVICE_CLIENT_ID=svc-universesimulator
SERVICE_CLIENT_SECRET=
# Sent as X-Internal-Key when no client secret is configured (dev).
OUTBOUND_INTERNAL_API_KEY=
SOCIAL_API_URL=http://social:3000
INVENTORY_API_URL=http://inventory:3000
MISSION_API_URL=http://mission:3000
ECONOMIE_API_URL=http://economie:3000
PERSISTENCE_API_URL=http://service-persistence:3001
PERSISTENCE_VALIDATE=true
HTTP_TIMEOUT_MS=5000
