PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (docker/docker-compose.yml builds DATABASE_URL from the POSTGRES_* values)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=market
POSTGRES_PORT=5432
DATABASE_URL=postgresql://user:password@localhost:5432/market

# Keycloak — player JWTs are validated against the realm JWKS (RS256); the `sub` claim is the player id
OIDC_ISSUER=http://keycloak:8080/realms/dyingstar
OIDC_JWKS_URL=
OIDC_AUDIENCE=
# Expected `aud` of service-account tokens (client_credentials) on /api/internal/*
OIDC_SERVICE_AUDIENCE=market-api

# Trusted Keycloak service clients (`azp`) allowed on /api/internal/*
INTERNAL_SERVICE_CLIENTS=svc-game

# Legacy shared secret. Only honoured in dev when INTERNAL_DEV_BYPASS=true.
INTERNAL_API_KEY=change-me

# Local dev without Keycloak: accept X-Internal-Key on /api/internal/* instead of a
# service-account JWT. Ignored when NODE_ENV=production (which refuses to start if true).
INTERNAL_DEV_BYPASS=false

# Local dev without Keycloak: accept X-Player-Id / X-Player-Name headers instead of a JWT.
AUTH_DEV_BYPASS=false

# Inventory integration: moves goods ownership at settlement
INVENTORY_API_URL=http://localhost:3002
INVENTORY_SERVICE_CLIENT_ID=svc-market
INVENTORY_SERVICE_CLIENT_SECRET=
INVENTORY_INTERNAL_API_KEY=

# Economy integration: moves credits at settlement
ECONOMY_API_URL=http://localhost:3000
ECONOMY_SERVICE_CLIENT_ID=svc-market
ECONOMY_SERVICE_CLIENT_SECRET=
ECONOMY_INTERNAL_API_KEY=

# Social integration: authorizes corporation orders (empty URL disables it)
SOCIAL_API_URL=http://localhost:3001
SOCIAL_SERVICE_CLIENT_ID=svc-market
SOCIAL_SERVICE_CLIENT_SECRET=
SOCIAL_INTERNAL_API_KEY=

# Market rules
# Default lifetime of an open order, in hours (0 = never expires)
MARKET_ORDER_TTL_HOURS=0
MARKET_DEFAULT_LIMIT=20
